<?xml version="1.0" encoding="utf-8"?>
<!-- Giant beds get the styleable comp their vanilla originals get from style mods (e.g. Alpha Memes). -->
<Patch>

  <Operation Class="PatchOperationConditional">
    <xpath>/Defs/ThingDef[defName="BS_BigBed"]/comps/li[@Class="CompProperties_Styleable"]</xpath>
    <nomatch Class="PatchOperationAdd">
      <xpath>/Defs/ThingDef[defName="BS_BigBed"]/comps</xpath>
      <value>
        <li Class="CompProperties_Styleable" />
      </value>
    </nomatch>
  </Operation>

